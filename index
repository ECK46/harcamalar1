<!doctype html>
<html lang="tr"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="Harcama">
<meta name="theme-color" content="#0a84ff">
<link rel="manifest" href="manifest.json">
<link rel="apple-touch-icon" href="icon-180.png">
<title>Harcama</title>
<style>
:root{--bg:#f2f2f7;--card:#fff;--t:#111;--s:#8a8a8e;--a:#0a84ff;--line:#e5e5ea;--r:16px}
@media(prefers-color-scheme:dark){:root{--bg:#000;--card:#1c1c1e;--t:#f5f5f7;--line:#2c2c2e}}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;background:var(--bg);color:var(--t);font:16px -apple-system,BlinkMacSystemFont,"SF Pro Text",system-ui,sans-serif}
#app{max-width:520px;margin:0 auto;padding:calc(env(safe-area-inset-top) + 14px) 16px calc(env(safe-area-inset-bottom) + 96px)}
h1{font-size:28px;margin:4px 2px 14px;letter-spacing:-.5px}
.seg{display:grid;grid-template-columns:repeat(3,1fr);background:var(--line);border-radius:12px;padding:3px}
.seg button{border:0;background:none;color:var(--s);font:600 14px inherit;padding:8px;border-radius:10px}
.seg button.on{background:var(--card);color:var(--t);box-shadow:0 1px 3px rgba(0,0,0,.15)}
.nav{display:flex;align-items:center;justify-content:space-between;margin:12px 0 10px}
.nav b{font-size:15px;font-weight:600}
.nav button{border:0;background:none;color:var(--a);font-size:26px;width:44px;height:36px}
.nav button:disabled{color:var(--line)}
.card{background:var(--card);border-radius:var(--r);padding:16px}
.tot{font-size:36px;font-weight:700;letter-spacing:-1px}
.sub{color:var(--s);font-size:13px;margin-top:2px}
.bars{margin-top:14px;display:grid;gap:9px}
.bar{display:grid;grid-template-columns:92px 1fr auto;gap:10px;align-items:center;font-size:13px}
.bar i{display:block;height:6px;border-radius:3px;background:var(--line);overflow:hidden}
.bar i u{display:block;height:100%;background:var(--a);border-radius:3px}
.bar span:last-child{color:var(--s);min-width:64px;text-align:right}
.chips{display:flex;gap:8px;overflow-x:auto;margin:14px -16px 6px;padding:2px 16px;scrollbar-width:none}
.chips::-webkit-scrollbar{display:none}
.chip{flex:none;border:0;background:var(--card);color:var(--t);font:500 14px inherit;padding:8px 13px;border-radius:20px}
.chip.on{background:var(--a);color:#fff}
.day{display:flex;justify-content:space-between;color:var(--s);font-size:12.5px;font-weight:600;margin:16px 6px 6px;text-transform:uppercase;letter-spacing:.3px}
.list{background:var(--card);border-radius:var(--r);overflow:hidden}
.it{display:flex;align-items:center;gap:12px;padding:12px 14px;border-top:1px solid var(--line)}
.it:first-child{border-top:0}
.ic{font-size:22px;width:34px;height:34px;display:grid;place-items:center;background:var(--bg);border-radius:10px}
.it div{flex:1;min-width:0}.it small{display:block;color:var(--s);font-size:12.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.it b{font-weight:600}
.empty{text-align:center;color:var(--s);padding:40px 0}
.fab{position:fixed;right:max(20px,calc(50% - 240px));bottom:calc(env(safe-area-inset-bottom) + 20px);width:58px;height:58px;border-radius:50%;border:0;background:var(--a);color:#fff;font-size:32px;box-shadow:0 6px 18px rgba(10,132,255,.45)}
.ov{position:fixed;inset:0;background:rgba(0,0,0,.4);display:none;align-items:flex-end;justify-content:center}
.ov.on{display:flex}
.sheet{background:var(--card);width:100%;max-width:520px;border-radius:22px 22px 0 0;padding:18px 16px calc(env(safe-area-inset-bottom) + 18px)}
.sheet h2{margin:0 0 12px;font-size:18px}
.sheet input{width:100%;border:0;background:var(--bg);color:var(--t);font:16px inherit;padding:12px;border-radius:12px;margin-top:8px}
.sheet #amt{font-size:30px;font-weight:700}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:10px}
.grid button{border:2px solid transparent;background:var(--bg);color:var(--t);border-radius:12px;padding:8px 2px;font:12px inherit}
.grid button span{display:block;font-size:22px}
.grid button.on{border-color:var(--a)}
.row{display:flex;gap:10px;margin-top:14px}
.row button{flex:1;border:0;border-radius:12px;padding:14px;font:600 16px inherit}
.ok{background:var(--a);color:#fff}.no{background:var(--bg);color:var(--t)}
</style></head><body>
<div id="app"></div>
<button class="fab" id="fab" aria-label="Ekle">+</button>
<div class="ov" id="ov"><div class="sheet">
<h2>Yeni harcama</h2>
<input id="amt" inputmode="decimal" placeholder="0 ₺" autocomplete="off">
<div class="grid" id="cg"></div>
<input id="note" placeholder="Not (isteğe bağlı)" autocomplete="off">
<input id="dt" type="date">
<div class="row"><button class="no" id="cancel">Vazgeç</button><button class="ok" id="save">Kaydet</button></div>
</div></div>
<script>
const CATS=[["Market","🛒"],["Yakıt","⛽️"],["Fatura","💡"],["Ulaşım","🚌"],["Yemek","🍽️"],["Sağlık","💊"],["Eğlence","🎬"],["Diğer","📦"]];
const IC=Object.fromEntries(CATS),K="harcamalar-v1",PER=[["day","Gün"],["week","Hafta"],["month","Ay"]];
let data=[];try{data=JSON.parse(localStorage.getItem(K))||[]}catch(e){}
let P="month",O=0,C="Tümü",sel="Market";
const $=s=>document.querySelector(s);
const store=()=>{try{localStorage.setItem(K,JSON.stringify(data))}catch(e){}};
const pad=n=>String(n).padStart(2,"0");
const iso=d=>d.getFullYear()+"-"+pad(d.getMonth()+1)+"-"+pad(d.getDate());
const money=n=>n.toLocaleString("tr-TR",{maximumFractionDigits:2})+" ₺";
const esc=s=>String(s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const dstr=(iso,o)=>new Date(iso+"T12:00:00").toLocaleDateString("tr-TR",o);
function range(){
  const n=new Date();let s=new Date(n.getFullYear(),n.getMonth(),n.getDate()),e;
  if(P==="day"){s.setDate(s.getDate()+O);e=new Date(s);e.setDate(e.getDate()+1)}
  else if(P==="week"){s.setDate(s.getDate()-((s.getDay()+6)%7)+O*7);e=new Date(s);e.setDate(e.getDate()+7)}
  else{s=new Date(n.getFullYear(),n.getMonth()+O,1);e=new Date(s.getFullYear(),s.getMonth()+1,1)}
  return [s,e];
}
function label(s,e){
  if(P==="day")return s.toLocaleDateString("tr-TR",{day:"numeric",month:"long",weekday:"long"});
  if(P==="month")return s.toLocaleDateString("tr-TR",{month:"long",year:"numeric"});
  const l=new Date(e);l.setDate(l.getDate()-1);const f={day:"numeric",month:"short"};
  return s.toLocaleDateString("tr-TR",f)+" – "+l.toLocaleDateString("tr-TR",f);
}
function render(){
  const [s,e]=range(),a=iso(s),b=iso(e);
  const all=data.filter(x=>x.d>=a&&x.d<b);
  const list=(C==="Tümü"?all:all.filter(x=>x.c===C)).sort((x,y)=>y.d.localeCompare(x.d)||y.id-x.id);
  const sum=l=>l.reduce((t,x)=>t+x.a,0),tot=sum(list);
  let h='<h1>Harcamalar</h1><div class="seg">'+PER.map(([k,n])=>`<button data-p="${k}" class="${P===k?"on":""}">${n}</button>`).join("")+"</div>";
  h+=`<div class="nav"><button data-n="-1">‹</button><b>${label(s,e)}</b><button data-n="1" ${O>=0?"disabled":""}>›</button></div>`;
  h+=`<div class="card"><div class="tot">${money(tot)}</div><div class="sub">${C==="Tümü"?"Tüm kategoriler":IC[C]+" "+C} · ${list.length} işlem</div>`;
  if(C==="Tümü"&&tot>0){
    const by={};all.forEach(x=>by[x.c]=(by[x.c]||0)+x.a);
    h+='<div class="bars">'+Object.entries(by).sort((x,y)=>y[1]-x[1]).slice(0,5).map(([k,v])=>`<div class="bar"><span>${IC[k]} ${k}</span><i><u style="width:${v/tot*100}%"></u></i><span>${money(v)}</span></div>`).join("")+"</div>";
  }
  h+="</div>";
  h+='<div class="chips">'+["Tümü",...CATS.map(c=>c[0])].map(k=>`<button class="chip ${C===k?"on":""}" data-c="${k}">${k==="Tümü"?"Tümü":IC[k]+" "+k}</button>`).join("")+"</div>";
  if(!list.length)h+='<div class="empty">Bu dönemde harcama yok</div>';
  const days=[...new Set(list.map(x=>x.d))];
  days.forEach(d=>{
    const l=list.filter(x=>x.d===d);
    h+=`<div class="day"><span>${dstr(d,{day:"numeric",month:"long",weekday:"long"})}</span><span>${money(sum(l))}</span></div><div class="list">`+
      l.map(x=>`<div class="it" data-id="${x.id}"><span class="ic">${IC[x.c]}</span><div>${x.c}<small>${esc(x.n||"")}</small></div><b>${money(x.a)}</b></div>`).join("")+"</div>";
  });
  $("#app").innerHTML=h;
}
$("#app").addEventListener("click",e=>{
  const t=e.target.closest("[data-p],[data-n],[data-c],.it");if(!t)return;
  if(t.dataset.p){P=t.dataset.p;O=0}
  else if(t.dataset.n){O=Math.min(0,O+ +t.dataset.n)}
  else if(t.dataset.c){C=t.dataset.c}
  else if(t.dataset.id){
    const x=data.find(y=>String(y.id)===t.dataset.id);
    if(x&&confirm(x.c+" · "+money(x.a)+"\nBu harcama silinsin mi?")){data=data.filter(y=>y!==x);store()}
  }
  render();
});
function drawCats(){$("#cg").innerHTML=CATS.map(([k,i])=>`<button data-k="${k}" class="${sel===k?"on":""}"><span>${i}</span>${k}</button>`).join("")}
$("#cg").addEventListener("click",e=>{const b=e.target.closest("[data-k]");if(b){sel=b.dataset.k;drawCats()}});
$("#fab").onclick=()=>{
  sel=C!=="Tümü"?C:sel;drawCats();$("#amt").value="";$("#note").value="";$("#dt").value=iso(new Date());
  $("#ov").classList.add("on");setTimeout(()=>$("#amt").focus(),50);
};
const close=()=>$("#ov").classList.remove("on");
$("#cancel").onclick=close;
$("#ov").addEventListener("click",e=>{if(e.target.id==="ov")close()});
$("#save").onclick=()=>{
  const v=parseFloat($("#amt").value.replace(",","."));
  if(!(v>0)){$("#amt").focus();return}
  data.push({id:Date.now(),d:$("#dt").value||iso(new Date()),a:v,c:sel,n:$("#note").value.trim()});
  store();close();render();
};
if("serviceWorker" in navigator)navigator.serviceWorker.register("sw.js").catch(()=>{});
render();
</script></body></html>
